---
import Layout from '@/layouts/Layout.astro'
import { Container, Section, Heading, Text, Button } from '@core/ui'
---
<Layout>
  <Section style={{ paddingTop: '120px', minHeight: '80vh' }}>
    <Container>
      <div style={{ marginBottom: '64px' }}>
        <Heading as="h1" size="5xl" style={{ marginBottom: '16px', letterSpacing: '-0.02em' }}>Documentation</Heading>
        <Text size="lg" color="text" style={{ opacity: 0.8, maxWidth: '600px' }}>
          Learn how to use the @core/ui design system primitives to build your pages rapidly.
        </Text>
      </div>

      <Heading as="h2" size="3xl" style={{ marginBottom: '24px' }}>Typography</Heading>
      <div style={{ display: 'flex', flexDirection: 'column', gap: '16px', marginBottom: '64px', padding: '32px', backgroundColor: 'color-mix(in srgb, var(--colors-hoverTint) 20%, transparent)', borderRadius: '16px', border: '1px solid var(--colors-hoverTint)' }}>
        <Heading size="4xl">This is a 4xl Heading</Heading>
        <Text size="lg" color="primary">This is large primary text.</Text>
        <Text size="sm" color="text" style={{ opacity: 0.6 }}>This is small muted text.</Text>
      </div>

      <Heading as="h2" size="3xl" style={{ marginBottom: '24px' }}>Buttons</Heading>
      <div style={{ display: 'flex', gap: '16px', flexWrap: 'wrap', padding: '32px', backgroundColor: 'color-mix(in srgb, var(--colors-hoverTint) 20%, transparent)', borderRadius: '16px', border: '1px solid var(--colors-hoverTint)' }}>
        <Button>Primary Button</Button>
        <Button variant="ghost">Ghost Button</Button>
      </div>
      
      <div style={{ marginTop: '64px' }}>
        <Button as="a" href="/" variant="ghost" style={{ textDecoration: 'none' }}>← Back to Home</Button>
      </div>
    </Container>
  </Section>
</Layout>
