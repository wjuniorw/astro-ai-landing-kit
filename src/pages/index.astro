---

<Layout>
	<SampleIsland client:load />
	
	<div style="height: 150vh; display: flex; justify-content: center; align-items: center; padding: 20px; text-align: center;">
		<p>👇 Role a página para baixo para ver o botão flutuante surgir! 👇</p>
	</div>
	
	<Welcome />
</Layout>
